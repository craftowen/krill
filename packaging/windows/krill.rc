#include "krill-version.h"

// Only the desktop app needs resource ID 1 for its window/taskbar icon.
#ifdef KRILL_APP
1 ICON "krill.ico"
#endif

1 VERSIONINFO
FILEVERSION KRILL_FILE_VERSION
PRODUCTVERSION KRILL_FILE_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Krill contributors\0"
            VALUE "FileDescription", KRILL_DESCRIPTION
            VALUE "FileVersion", KRILL_VERSION
            VALUE "InternalName", KRILL_INTERNAL_NAME
            VALUE "OriginalFilename", KRILL_ORIGINAL_FILENAME
            VALUE "ProductName", "Krill\0"
            VALUE "ProductVersion", KRILL_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

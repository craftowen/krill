#!/usr/bin/env bash
# git pre-commit(설치: scripts/install-hooks.sh). main은 출고된 커밋만 fast-forward로 따라가는 포인터다
# (packaging/README.md 야간 출고 1·6번). 작업은 origin/dev에서 딴 브랜치에서 하고 dev에 PR로 넣는다.
set -euo pipefail
if [[ $(git symbolic-ref --quiet --short HEAD 2>/dev/null || true) == main ]]; then
  echo "pre-commit: main 브랜치에는 커밋하지 않는다. origin/dev에서 브랜치를 따서 작업하고 dev에 PR로 넣는다(krill worktree new <이름>)." >&2
  exit 1
fi

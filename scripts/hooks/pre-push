#!/usr/bin/env bash
# git pre-push(설치: scripts/install-hooks.sh). AGENTS.md 규칙 9 기계 강제.
# - main 브랜치·v* 태그 push는 승인 사유가 있어야 한다. 사용자 지시를 받은 에이전트도 실행할 수 있다.
# - push하는 각 ref의 끝 커밋을 풀어 scripts/public-surface.sh로 점검한다(내부 문서·비밀 유출 차단).
# stdin 한 줄 = "<local ref> <local sha> <remote ref> <remote sha>" (githooks(5)).
set -euo pipefail
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
fail=0
while read -r lref lsha rref _rsha; do
  case $rref in
    refs/heads/main|refs/tags/v*)
      if [[ ${KRILL_ALLOW_PROTECTED_PUSH-} =~ [^[:space:]] ]]; then
        echo "pre-push: 보호 ref $rref push 허용(KRILL_ALLOW_PROTECTED_PUSH 사유: $KRILL_ALLOW_PROTECTED_PUSH)" >&2
      else
        echo "pre-push: 보호 ref $rref push 차단 — 사용자 지시에 따른 승인 사유가 필요하다(AGENTS.md 규칙 9)." >&2
        echo "          배포·릴리스·push 지시를 받았으면: KRILL_ALLOW_PROTECTED_PUSH='<사용자 지시와 작업 사유>' git push ..." >&2
        fail=1
        continue
      fi ;;
  esac
  [[ $lsha == "$zero" ]] && continue # ref 삭제는 내용 점검 없음
  # 주석 태그도 끝 커밋을 검사한다. 검사할 수 없는 트리·blob 태그를 통과시키지 않는다.
  if ! commit=$(git rev-parse --verify -q "${lsha}^{commit}" 2>/dev/null); then
    echo "pre-push: $lref($lsha) 커밋으로 해석할 수 없는 ref — 공개 표면을 검사할 수 없어 차단" >&2
    fail=1
    continue
  fi
  if [[ ! -f $root/scripts/public-surface.sh ]]; then
    echo "pre-push: scripts/public-surface.sh가 없어 공개 표면을 점검할 수 없다 — 차단" >&2
    fail=1
    continue
  fi
  dir=$(mktemp -d)
  git -C "$root" archive "$commit" | tar -x -C "$dir"
  if ! bash "$root/scripts/public-surface.sh" "$dir"; then
    echo "pre-push: $lref($lsha) 공개 표면 점검 실패 — 차단" >&2
    fail=1
  fi
  rm -rf "$dir"
done
exit $fail
